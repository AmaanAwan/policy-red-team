# ============================================================
# Automated Regulatory Robustness Testing — Environment Config
# ============================================================
# Copy this file to `.env` and fill in your credentials:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ============================================================

# ----------------------------------------------------------
# LlamaCloud (REQUIRED for PDF extraction)
# ----------------------------------------------------------
# Get your API key at: https://cloud.llamaindex.ai/api-key
LLAMA_CLOUD_API_KEY=llx-your-key-here

# ----------------------------------------------------------
# Embedding Provider Mode
# ----------------------------------------------------------
# "vertex" (default, production) or "mock" (for zero-GCP local testing).
# If GOOGLE_CLOUD_PROJECT is blank, the system automatically runs in
# Local Test Mode using MockEmbedding (no GCP credentials required).
EMBEDDING_PROVIDER=vertex

# ----------------------------------------------------------
# Google Cloud Platform (Optional for local test mode)
# ----------------------------------------------------------
# Your GCP project ID (e.g., "my-thesis-project-123456")
GOOGLE_CLOUD_PROJECT=

# Vertex AI region (e.g., "us-central1", "europe-west1")
GOOGLE_CLOUD_LOCATION=us-central1

# Path to your GCP service account JSON key file (optional).
# Leave blank if using `gcloud auth application-default login` or mock mode.
GOOGLE_APPLICATION_CREDENTIALS=
